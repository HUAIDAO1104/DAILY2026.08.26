<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SYSTEM_OVERLAY_WINDOW" />

    <!-- 前台通知（通知栏常驻） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 此权限在适用于Android 10以下（包含），Android 11 引入queries，但勉强能用，再往上就不行了，只能通过queries查询指定的应用 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        android:maxSdkVersion="30"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".DailyTaskApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.DailyTask.Dark"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DailyTask.Dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.SettingsActivity" />
        <activity android:name=".ui.CalendarActivity" />
        <activity android:name=".ui.ExecutionRecordsActivity" />
        <activity android:name=".ui.RecordDetailActivity" />
        <activity android:name=".ui.HolidayRulesActivity" />
        <activity android:name=".ui.BackupActivity" />
        <activity android:name=".ui.TaskManagementActivity" />
        <activity android:name=".ui.TaskEditorActivity" />
        <activity
            android:name=".ui.MessageChannelActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.TaskConfigActivity" />
        <activity android:name=".ui.CommandActivity" />
        <activity android:name=".ui.QuestionAndAnswerActivity" />
        <activity
            android:name=".ui.AiAssistantActivity"
            android:theme="@style/Theme.DailyTask.Dark"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.LeaveManagementActivity"
            android:theme="@style/Theme.DailyTask.Dark" />

        <service android:name=".service.FloatingWindowService" />
        <service
            android:name=".service.ForegroundRunningService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-enabled local schedules active and displays execution countdowns" />
        </service>
        <service
            android:name=".service.NotificationMonitorService"
            android:enabled="true"
            android:exported="false"
            android:label="@string/notification_monitor_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".service.CaptureImageService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".receiver.TaskRestoreReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <package android:name="com.alibaba.android.rimet" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.wework" />
        <package android:name="com.ss.android.lark" />
        <package android:name="com.seeyon.cmp" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.tim" />
        <package android:name="com.eg.android.AlipayGphone" />
    </queries>
</manifest>
