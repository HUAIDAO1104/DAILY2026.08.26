<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_dark">

    <com.pengxh.daily.app.widget.AuroraBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentInsetStartWithNavigation="4dp"
            android:minHeight="56dp"
            app:navigationIcon="@drawable/ic_back_modern"
            app:title="消息渠道"
            app:titleTextColor="@color/text_primary_dark" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="19dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="接收任务结果"
                    android:textAppearance="@style/TextAppearance.DailyTask.LargeTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="配置后先发送一次测试，测试成功的渠道会成为默认通知方式。"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="24dp" android:layout_marginBottom="9dp" android:text="通用" android:textAppearance="@style/TextAppearance.DailyTask.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:background="@drawable/bg_glass_group"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="消息标题" android:textColor="@color/text_primary_dark" android:textSize="13sp" android:textStyle="bold" />
                    <com.pengxh.kt.lite.widget.DeletableEditText
                        android:id="@+id/messageTitleView"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:hint="非必填"
                        android:singleLine="true"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/text_tertiary_dark"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="24dp" android:layout_marginBottom="9dp" android:text="企业微信" android:textAppearance="@style/TextAppearance.DailyTask.Label" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_glass_group" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="群机器人 Webhook" android:textColor="@color/text_primary_dark" android:textSize="13sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="只需填写地址中的 key 参数" android:textColor="@color/text_secondary_dark" android:textSize="9sp" /></LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/sendWxButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="测试" android:textColor="@color/white" android:textSize="11sp" app:backgroundTint="@color/accent_red" app:cornerRadius="12dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="key" android:textColor="@color/text_primary_dark" android:textSize="13sp" android:textStyle="bold" /><com.pengxh.kt.lite.widget.DeletableEditText android:id="@+id/wxKeyView" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="12dp" android:layout_weight="1" android:background="@null" android:gravity="end|center_vertical" android:hint="粘贴企业微信 key" android:singleLine="true" android:textColor="@color/text_primary_dark" android:textColorHint="@color/text_tertiary_dark" android:textSize="11sp" /></LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="24dp" android:layout_marginBottom="9dp" android:text="QQ 邮箱" android:textAppearance="@style/TextAppearance.DailyTask.Label" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:background="@drawable/bg_glass_group" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SMTP 邮件通知" android:textColor="@color/text_primary_dark" android:textSize="13sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="授权码不是 QQ 登录密码" android:textColor="@color/text_secondary_dark" android:textSize="9sp" /></LinearLayout><com.google.android.material.button.MaterialButton android:id="@+id/sendEmailButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="测试" android:textColor="@color/white" android:textSize="11sp" app:backgroundTint="@color/accent_red" app:cornerRadius="12dp" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="发件账号" android:textColor="@color/text_primary_dark" android:textSize="13sp" android:textStyle="bold" /><com.pengxh.kt.lite.widget.DeletableEditText android:id="@+id/emailSendAddressView" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="12dp" android:layout_weight="1" android:background="@null" android:gravity="end|center_vertical" android:hint="QQ 号" android:inputType="number" android:maxLength="15" android:singleLine="true" android:textColor="@color/text_primary_dark" android:textColorHint="@color/text_tertiary_dark" android:textSize="11sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@qq.com" android:textColor="@color/text_secondary_dark" android:textSize="10sp" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="授权码" android:textColor="@color/text_primary_dark" android:textSize="13sp" android:textStyle="bold" /><com.pengxh.kt.lite.widget.DeletableEditText android:id="@+id/emailSendCodeView" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="12dp" android:layout_weight="1" android:background="@null" android:gravity="end|center_vertical" android:hint="16 位 SMTP 授权码" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/text_primary_dark" android:textColorHint="@color/text_tertiary_dark" android:textSize="11sp" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" />
                    <LinearLayout android:id="@+id/emailLayout" android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收件邮箱" android:textColor="@color/text_primary_dark" android:textSize="13sp" android:textStyle="bold" /><com.pengxh.kt.lite.widget.DeletableEditText android:id="@+id/emailInboxView" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="12dp" android:layout_weight="1" android:background="@null" android:gravity="end|center_vertical" android:hint="name@example.com" android:inputType="textEmailAddress" android:singleLine="true" android:textColor="@color/text_primary_dark" android:textColorHint="@color/text_tertiary_dark" android:textSize="11sp" /></LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
