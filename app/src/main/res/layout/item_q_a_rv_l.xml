    <com.google.android.material.textview.MaterialTextView android:id="@+id/answerView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary_dark" android:textSize="12sp" android:lineSpacingExtra="3dp" />
</LinearLayout>
