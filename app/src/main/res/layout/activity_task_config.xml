<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_dark">

    <com.pengxh.daily.app.widget.AuroraBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentInsetStartWithNavigation="4dp"
            android:minHeight="56dp"
            app:navigationIcon="@drawable/ic_back_modern"
            app:title="任务规则"
            app:titleTextColor="@color/text_primary_dark" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="19dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="任务运行方式"
                    android:textAppearance="@style/TextAppearance.DailyTask.LargeTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="这些规则会应用到每天的自动任务，也可以交给 AI 助手修改。"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="9dp"
                    android:text="时间"
                    android:textAppearance="@style/TextAppearance.DailyTask.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_group"
                    android:orientation="vertical">

                    <RelativeLayout android:id="@+id/resetTimeLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="每日重置" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/resetTimeView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:textColor="@color/accent_red" android:textSize="12sp" />
                    </RelativeLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" />
                    <RelativeLayout android:id="@+id/timeoutLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:paddingHorizontal="16dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="单次超时" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="超过时间后记为未完成" android:textColor="@color/text_secondary_dark" android:textSize="12sp" /></LinearLayout>
                        <TextView android:id="@+id/timeoutTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:textColor="@color/accent_red" android:textSize="12sp" />
                    </RelativeLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" />
                    <RelativeLayout android:id="@+id/keyLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:paddingHorizontal="16dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="远程口令" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="收到此文字后触发任务" android:textColor="@color/text_secondary_dark" android:textSize="12sp" /></LinearLayout>
                        <TextView android:id="@+id/keyTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:textColor="@color/accent_red" android:textSize="12sp" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="24dp" android:layout_marginBottom="9dp" android:text="日期与循环" android:textAppearance="@style/TextAppearance.DailyTask.Label" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_glass_group" android:orientation="vertical">
                    <LinearLayout android:id="@+id/workdayLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="工作日" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/workdayValueView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:ellipsize="end" android:gravity="end" android:maxLines="2" android:textColor="@color/text_secondary_dark" android:textSize="14sp" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" />
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="跳过法定节假日" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="自动识别节假日与调休" android:textColor="@color/text_secondary_dark" android:textSize="12sp" /></LinearLayout><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/skipHolidaySwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" /></RelativeLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" />
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="循环任务" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="远程指令可以暂停或恢复" android:textColor="@color/text_secondary_dark" android:textSize="12sp" /></LinearLayout><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/autoTaskSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:clickable="false" android:focusable="false" /></RelativeLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="24dp" android:layout_marginBottom="9dp" android:text="执行节奏" android:textAppearance="@style/TextAppearance.DailyTask.Label" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_glass_group" android:orientation="vertical">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="随机执行时间" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="在任务时间附近随机运行" android:textColor="@color/text_secondary_dark" android:textSize="12sp" /></LinearLayout><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/randomTimeSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" /></RelativeLayout>
                    <LinearLayout android:id="@+id/minuteRangeLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/divider_dark" /><RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:paddingHorizontal="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="随机范围" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/minuteRangeView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:textColor="@color/accent_red" android:textSize="12sp" /></RelativeLayout></LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/exportLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingVertical="12dp" android:layout_marginTop="16dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_glass_group" android:gravity="center_vertical" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="导出配置" android:textColor="@color/text_primary_dark" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="分享或复制当前完整配置" android:textColor="@color/text_secondary_dark" android:textSize="12sp" /></LinearLayout><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right_modern" /></LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
