<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_dark">

    <com.pengxh.daily.app.widget.AuroraBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ai_page_overlay" />

    <LinearLayout
        android:id="@+id/assistantContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentInsetStart="0dp"
            android:contentInsetEnd="0dp"
            android:minHeight="64dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.pengxh.daily.app.widget.AiCompanionView
                    android:id="@+id/headerOrb"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 操作助手"
                        android:textColor="@color/ai_text_warm"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="修改前先核对 · 配置只存本机"
                        android:textColor="@color/ai_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/aiConfigButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="44dp"
                    android:minWidth="0dp"
                    android:text="模型"
                    android:textColor="@color/ai_text_rose"
                    android:textSize="12sp"
                    app:backgroundTint="@color/ai_surface_wine_soft"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_model_modern"
                    app:iconPadding="5dp"
                    app:iconSize="17dp"
                    app:iconTint="@color/ai_highlight_copper"
                    app:strokeColor="@color/ai_stroke_rose"
                    app:strokeWidth="1dp" />

                <ImageView
                    android:id="@+id/closeButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle_glass"
                    android:contentDescription="关闭"
                    android:padding="13dp"
                    android:src="@drawable/ic_close_round" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:id="@+id/assistantPresenceCard"
            android:layout_width="match_parent"
            android:layout_height="228dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.pengxh.daily.app.widget.AiCompanionView
                android:id="@+id/assistantOrb"
                android:layout_width="174dp"
                android:layout_height="174dp"
                android:contentDescription="点击唤醒 AI 操作助手" />

            <TextView
                android:id="@+id/assistantStateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:text="在这儿，随时可以开始"
                android:textColor="@color/ai_text_warm"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/assistantStateDetailView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="直接告诉我你想修改什么"
                android:textColor="@color/ai_text_rose"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/conversationScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/conversationLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/suggestionScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="9dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/leaveSuggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="42dp"
                    android:text="明天请假"
                    android:textColor="@color/ai_text_rose"
                    android:textSize="12sp"
                    app:backgroundTint="@color/ai_surface_wine_soft"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/ai_stroke_rose"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/weekendSuggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="42dp"
                    android:text="周末节假日不打卡"
                    android:textColor="@color/ai_text_rose"
                    android:textSize="12sp"
                    app:backgroundTint="@color/ai_surface_wine_soft"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/ai_stroke_rose"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/randomSuggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="42dp"
                    android:text="关闭随机时间"
                    android:textColor="@color/ai_text_rose"
                    android:textSize="12sp"
                    app:backgroundTint="@color/ai_surface_wine_soft"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/ai_stroke_rose"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/composerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/promptInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="输入任务、请假或设置…"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="48dp"
                android:paddingHorizontal="9dp"
                android:textColor="@color/ai_text_warm"
                android:textColorHint="@color/ai_text_muted"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/sendButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_send_plane_button"
                android:contentDescription="发送"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send_plane_modern" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
