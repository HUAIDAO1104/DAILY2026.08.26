<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_red_soft"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_model_modern"
        app:tint="@color/accent_red" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/modelNameView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modelOwnerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary_dark"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/modelSelectedIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="已选择"
        android:src="@drawable/ic_check_modern"
        android:visibility="gone"
        app:tint="@color/success_green" />
</LinearLayout>
