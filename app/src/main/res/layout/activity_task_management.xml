<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_background_dark">
    <com.pengxh.daily.app.widget.AuroraBackgroundView android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" android:minHeight="58dp" app:navigationIcon="@drawable/ic_back_modern" app:title="任务" app:titleTextColor="@color/text_primary_dark">
            <TextView android:id="@+id/globalConfigButton" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_gravity="end" android:background="@drawable/bg_status_pill" android:gravity="center" android:paddingHorizontal="11dp" android:text="全局规则" android:textColor="@color/accent_red" android:textSize="10sp" />
        </com.google.android.material.appbar.MaterialToolbar>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="19dp" android:paddingBottom="22dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="工作日任务" android:textAppearance="@style/TextAppearance.DailyTask.LargeTitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="任务按时间顺序执行，并自动遵循节假日、周末和请假规则。" android:textColor="@color/text_secondary_dark" android:textSize="11sp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="22dp" android:layout_weight="1" android:background="@drawable/bg_glass_group">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:overScrollMode="never" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                <TextView android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="还没有任务" android:textColor="@color/text_secondary_dark" android:textSize="12sp" android:visibility="gone" />
            </FrameLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/addButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:text="添加任务" android:textColor="@color/white" app:backgroundTint="@color/accent_red" app:cornerRadius="14dp" app:icon="@drawable/ic_plus_round" app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
