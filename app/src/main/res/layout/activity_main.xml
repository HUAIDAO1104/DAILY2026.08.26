<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_dark"
    android:clipChildren="false"
    android:keepScreenOn="true">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.pengxh.daily.app.widget.AuroraBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </eightbitlab.com.blurview.BlurTarget>

    <LinearLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentInsetStart="17dp"
            android:contentInsetEnd="17dp"
            android:minHeight="54dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_red_gradient_button"
                    android:contentDescription="DailyTask"
                    android:padding="7dp"
                    android:src="@drawable/ic_app_mark"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="DailyTask"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/addTaskButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_glass"
                    android:clickable="true"
                    android:contentDescription="添加任务"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_plus_round"
                    app:tint="@color/accent_red" />

                <LinearLayout
                    android:id="@+id/aiTopButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_card_small"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp">

                    <com.pengxh.daily.app.widget.AiCompanionView
                        android:id="@+id/aiTopOrb"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="AI 助手"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="17dp">

                <TextView
                    android:id="@+id/homeDateView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="15dp"
                    android:text="8月26日 · 星期三　工作日"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:elevation="2dp"
                    android:minHeight="244dp"
                    android:padding="18dp">

                    <View
                        android:id="@+id/heroGlow"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-86dp"
                        android:layout_marginEnd="-70dp"
                        android:background="@drawable/bg_circle_red_soft"
                        android:alpha="0.22" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="40dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/heroKickerView"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.12"
                                android:text="NEXT TASK"
                                android:textColor="#A6FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/executeTaskButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="76dp"
                                android:minHeight="40dp"
                                android:text="已就绪"
                                android:textAllCaps="false"
                                android:textColor="@color/accent_red"
                                android:textSize="12sp"
                                app:backgroundTint="@color/accent_red_soft"
                                app:cornerRadius="17dp"
                                app:icon="@drawable/ic_status_dot"
                                app:iconSize="10dp"
                                app:iconTint="@color/accent_red" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/nextTaskTimeView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.06"
                            android:maxLines="2"
                            android:text="18:05"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="54sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroTaskTitleView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="下班打卡　企业微信"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tipsView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="2"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="12sp" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="18dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider_dark" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:minHeight="34dp"
                            android:orientation="horizontal"
                            android:paddingTop="12dp">

                            <TextView
                                android:id="@+id/repeatTimeView"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:maxLines="2"
                                android:text="预计 18:02—18:08"
                                android:textColor="#9EFFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/heroProgressView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="今日完成 1 / 2"
                                android:textColor="#9EFFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <LinearLayout
                    android:id="@+id/aiAssistantLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_card_small"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="78dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="13dp">

                    <com.pengxh.daily.app.widget.AiCompanionView
                        android:id="@+id/aiInsightOrb"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI 今日检查"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/aiInsightNoteView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="权限、网络与日期规则正常，可按时执行"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_status_pill"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="查看"
                        android:textColor="@color/accent_red"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="今日任务"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/taskCountView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 2"
                        android:textColor="@color/text_tertiary_dark"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/leaveStatusView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_glass_group">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <LinearLayout
                        android:id="@+id/emptyView"
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_circle_red_soft"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_plus_round"
                            app:tint="@color/accent_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="还没有任务"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="点击右上角添加按钮，创建第一个时间点"
                                android:textColor="@color/text_secondary_dark"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/aiPromptLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="26dp"
                    android:background="@drawable/bg_glass_card_small"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <com.pengxh.daily.app.widget.AiCompanionView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="问 AI：今天为什么不打卡？"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="打开 AI 助手"
                        android:src="@drawable/ic_prompt_arrow_modern"
                        app:tint="@color/text_secondary_dark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quickLeaveButton"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <include layout="@layout/include_bottom_navigation" />

    <RelativeLayout
        android:id="@+id/maskView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <TextClock
            android:id="@+id/clockView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/ds_digital"
            android:format24Hour="HH:mm"
            android:textColor="#B3FFFFFF"
            android:textSize="56sp" />
    </RelativeLayout>
</FrameLayout>
