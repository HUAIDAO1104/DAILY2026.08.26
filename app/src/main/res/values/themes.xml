<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.DailyTask" parent="Theme.Material3.Light.NoActionBar">
        <!-- 修改控件系统默认颜色 -->
        <item name="colorPrimary">@color/theme_color</item>
        <item name="colorSecondary">@color/theme_color</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.DailyTask" parent="Base.Theme.DailyTask" />

    <style name="Theme.DailyTask.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_red_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/accent_red</item>
        <item name="colorSecondaryContainer">@color/accent_red_container</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorTertiary">@color/accent_red</item>
        <item name="android:colorAccent">@color/accent_red</item>
        <item name="android:navigationBarColor">@color/app_background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_background_dark</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DailyTask.Dialog</item>
    </style>

    <style name="ThemeOverlay.DailyTask.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_elevated_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorPrimary">@color/accent_red</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DailyTask.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.DailyTask.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.DailyTask.DialogBody</item>
    </style>

    <style name="ShapeAppearance.DailyTask.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="TextAppearance.DailyTask.LargeTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.035</item>
    </style>

    <style name="TextAppearance.DailyTask.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.DailyTask.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_tertiary_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.DailyTask.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">21sp</item>
    </style>

    <style name="TextAppearance.DailyTask.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_tertiary_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">17sp</item>
    </style>

    <style name="TextAppearance.DailyTask.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">27sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.DailyTask.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">22sp</item>
    </style>
</resources>
