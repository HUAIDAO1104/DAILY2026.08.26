<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#A33A3A45"
                android:centerColor="#8A22232B"
                android:endColor="#72131319" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#15FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
